                    </div>
 -->
                    <input type="submit" value="" class="searchbtn" disabled="disabled"/>
 
                        <div class="deletesearch fontheader"><a href="#">&nbsp;</a></div>
                        <div class="headline2 halde">
                            <div>offene Scandateien</div>
                            <a wicket:id="refresh">
                                <img src="image/refresh.png" alt="Seite neu laden" title="Refresh"/>
                            </a>
                            <!-- Der hier dient zum Beenden des Requests und wird per init.js#$.fn.clickHiddenLink() aufgerufen -->
                            <a class="hiddenlink invisible" wicket:id="hiddenlink"></a>
                        </div> 

                        <div class="tblwrapphalde">
                            <div class="viewbusy"></div>
                            <div class="tblscroll">
    
                                <div class="foundhint invisible" style="display: none;">
                                    Bitte starten Sie eine Suche,<br>damit Ihnen Fundstellen angezeigt werden.
                                </div>
                                <div class="searchhint invisible" style="display: none;">
                                    Zu den von Ihnen gewählten Suchbegriffen wurden keine passenden Daten im Archiv
                                    gefunden.
                                    <p>Erweitern Sie die Suche mit Wildcards: '<b> * </b>' für beliebig viele Zeichen oder '<b> ? </b>' f�r
                                        einzelne Zeichen.</p>
                                </div>
                                
                                <div class="searchBusy invisible"></div>
                                <table class="fixedHeaderTblRec">
                                    <thead>
                                        <tr class="fontheader">
                                            <!-- <th class="" scope="col">Nr.</th> -->
                                            <th class="" scope="col">Filename</th>
                                            <th class="" scope="col">Datum</th>
                                            <th class="" scope="col">Größe</th>
                                        </tr>
                                    </thead>
                                    <tbody  wicket:id="tblAjaxContainer">
                                        <tr class="" wicket:id="pdffiles">
                                            <!-- <td class="" wicket:id="filenr">[NR]</td> -->
                                            <td class="alignleft filename" wicket:id="filename"></td>
                                            <td class="alignleft" wicket:id="filedate">[07.08.2014 19:22]</td>
                                            <td class="alignright" wicket:id="filesize">[554.680]</td>
                                        </tr>
                                    </tbody>
                                    
                                </table>
                            </div>
                        </div>
                        
                        <div wicket:id="navigator">[dataview navigator]</div>
                        
                        <div class="fontheader foundinfo">
                            &nbsp;<span wicket:id="filecnt">[1234]</span> Files insgesamt gefunden.
                        </div>

                </fieldset>
            </form>
            
            <div class="wrappview">            
