<wicket:panel>

             <style>
                div.wicket-aa {
                    font-family: "Lucida Grande","Lucida Sans Unicode",Tahoma,Verdana;
                    font-size: 12px;
                    background-color: white;
                    border-width: 1px;
                    border-color: #cccccc;
                    border-style: solid;
                    padding: 2px;
                    margin: 1px 0 0 0;
                    text-align:left;
                }
                div.wicket-aa ul { list-style:none; padding: 2px; margin:0; }
                div.wicket-aa ul li.selected { background-color: #B3C4AF; padding: 2px; margin:0; }
            </style>
            
            <form action="forms.html" method="post" class="offeneScan" id="hannebambel">
                <fieldset>
<!-- 
                    <div class="switchpanel" style="clear:both">
                        
                        <div class="styled-select">
                            <label for="vorn">Belegart ?</label>
                            <select name="n" disabled="disabled" alt="TEST !" title="TEST !">
                                <option value="1">TB-Gut</option>
                                <option value="1">TB-Lie</option>
                                <option value="1">TB-Nac</option>
                                <option value="1">SC-Rec</option>
                                <option value="1">SC-Lie</option>
                                <option value="1">SC-Ret</option>
                                <option value="1">SC-Son</option>
